        {
          "name": "Create User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\nconst data = pm.response.json();\r\n\r\npm.test(\"Name và job đúng dữ liệu đã gửi\", function () {\r\n    const sent = JSON.parse(pm.request.body.raw);\r\n    pm.expect(data.name).to.eql(sent.name);\r\n    pm.expect(data.job).to.eql(sent.job);\r\n});\r\n\r\npm.environment.set(\"userId\", data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"name\": \"An Nguyen\",\r\n  \"job\": \"QA Lead\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
